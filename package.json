{
  "name": "zundamon-video-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/Root.tsx",
    "validate": "tsx scripts/validate-script.ts",
    "voice": "tsx scripts/generate-voices.ts",
    "timeline": "tsx scripts/generate-timeline.ts",
    "preview": "tsx scripts/preview.ts",
    "render": "tsx scripts/generate-video.ts",
    "studio:dev": "vite --config vite.studio.config.ts",
    "studio:build": "vite build --config vite.studio.config.ts && esbuild src/studio/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-studio/preload.cjs",
    "studio:start": "esbuild src/studio/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-studio/preload.cjs && NODE_OPTIONS='--import tsx' electron src/studio/main/main.ts",
    "video": "tsx scripts/generate-video.ts",
    "test": "vitest run --exclude tests/voicevox.integration.test.ts",
    "test:studio:e2e": "esbuild src/studio/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-studio/preload.cjs && esbuild tests/studio/asset-electron.e2e.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-studio/asset-electron.e2e.mjs && electron dist-studio/asset-electron.e2e.mjs",
    "test:integration": "vitest run tests/voicevox.integration.test.ts",
    "test:render": "tsx scripts/generate-video.ts sample-video --skip-voice"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "4.0.499",
    "@remotion/player": "4.0.499",
    "@remotion/renderer": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "41.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "vite": "6.4.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "0.28.1",
    "fast-check": "4.9.0",
    "jsdom": "^24.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "4.1.10"
  }
}
